<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>brash_world_model</name>
  <version>0.1.0</version>
  <description>Symbolic world state for robots, objects, containers, and locations, grounded in Twin Studio map bundles.</description>
  <maintainer email="robotics@brash.dev">Brash Robotics</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>brash_interfaces</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>python3-yaml</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
